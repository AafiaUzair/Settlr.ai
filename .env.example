# ─────────────────────────────────────────────────────────────────────────
# Settlr.ai — environment template
# ─────────────────────────────────────────────────────────────────────────

# ─── EmailJS (client-side email delivery for Party B invites) ───────────
# Dashboard → Account → API Keys / Email Services / Email Templates
EMAILJS_PUBLIC_KEY=key here
EMAILJS_SERVICE_ID=id here
EMAILJS_TEMPLATE_ID=template_id_here

# Optional: verified sender address shown in the invite email body.
EMAILJS_FROM_NAME=Settlr.ai - AI Neutral Mediator

# ─── Qwen / Alibaba Cloud Model Studio ──────────────────────────────────
# SECURITY: this is a SERVER-SIDE secret. It must never be shipped to the
# browser or embedded in index.html. Consume it only from a backend or a
# serverless function that proxies mediation requests.
QWEN_API_KEY=YOUR_QWEN_API_KEY_HERE
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ─── Sandbox payment gateway (simulated in this prototype) ──────────────
# Test-mode keys only. Stripe test keys start with `pk_test_` / `sk_test_`.
# The `sk_` secret key belongs on the server, never in the client bundle.
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_TEST_KEY_HERE
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_TEST_KEY_HERE
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID_HERE

# ─── App ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5501
APP_ENV=development
